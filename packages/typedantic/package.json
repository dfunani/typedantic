{
    "name": "@typedantic/model",
    "version": "0.1.0",
    "description": "Pydantic-style BaseModel, Field decorators, and model config for TypeScript",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "LICENSE",
        "CHANGELOG.md"
    ],
    "sideEffects": false,
    "scripts": {
        "build": "tsup src/index.ts --format esm --dts --clean",
        "typecheck": "tsc --noEmit",
        "clean": "rm -rf dist",
        "prepublishOnly": "bun run build"
    },
    "dependencies": {
        "@typedantic/core": "workspace:*",
        "reflect-metadata": "^0.2.2"
    },
    "peerDependencies": {
        "reflect-metadata": ">=0.2.0"
    },
    "engines": {
        "node": ">=20"
    },
    "license": "MIT",
    "author": "typedantic contributors",
    "homepage": "https://github.com/dfunani/typedantic#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/dfunani/typedantic.git",
        "directory": "packages/typedantic"
    },
    "bugs": {
        "url": "https://github.com/dfunani/typedantic/issues"
    },
    "keywords": [
        "validation",
        "basemodel",
        "decorators",
        "typescript",
        "pydantic",
        "typedantic"
    ],
    "publishConfig": {
        "access": "public",
        "provenance": true
    }
}
